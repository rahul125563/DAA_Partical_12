from functools import lru_cache

def tsp(graph):
    n = len(graph)
    ALL_VISITED = (1 << n) - 1

    @lru_cache(None)
    def solve(city, visited):
        if visited == ALL_VISITED:
            return graph[city][0]

        ans = float('inf')

        for next_city in range(n):
            if not (visited & (1 << next_city)):
                cost = (
                    graph[city][next_city]
                    + solve(
                        next_city,
                        visited | (1 << next_city)
                    )
                )
                ans = min(ans, cost)

        return ans

    return solve(0, 1)


graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

print("Minimum travelling cost:", tsp(graph))
